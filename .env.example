# Copy this file to .env.local and fill in the values.

# Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Optional: require a passcode to open the app. Set this before opening it from your phone.
APP_PASSCODE=

# Optional: model for the coach (default claude-opus-5-5)
# COACH_MODEL=claude-opus-5-5

# Optional: use a hosted Turso/libSQL database instead of the local file (data/coach.db)
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=